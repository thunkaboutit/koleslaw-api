ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/koleslaw_api
REDIS_URL=redis://localhost:6379/0
API_KEY_HASH_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=ollama_chat/prompt-enhance-14b-think
# Cloud model used when the local tier is unavailable (empty = disabled)
FALLBACK_MODEL=
# Per-client-IP daily cap on LLM endpoints for anonymous keys (0 disables).
# Which keys count as anonymous is ANON_KEY_HASHES (JSON list of sha256 key
# hashes); the default is the portal playground key.
ANON_DAILY_LIMIT=10
ENVIRONMENT=development
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
